# ==========================================
# TaskForge Environment Configuration
# ==========================================

# ---------------- Server & Database ----------------
# MongoDB Connection String (MongoDB Compass / Atlas)
# For local dev: mongodb://localhost:27017/taskforge
# For production Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/taskforge?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/taskforge

# Server Port
PORT=5001

# Node Environment ('development' | 'production')
NODE_ENV=development

# JWT Secret for session authentication (generate a strong 64-char key in production)
JWT_SECRET=taskforge-super-secret-jwt-key-change-in-production-min-32-chars

# Client URL (where the React frontend is hosted)
CLIENT_URL=http://localhost:5173

# ---------------- Email (SMTP / Resend / SendGrid) ----------------
# Leave empty for development stream transport (logs emails to console)
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=postmaster@your-domain.com
SMTP_PASS=your-smtp-password
MAIL_FROM="TaskForge <no-reply@taskforge.dev>"

# ---------------- Client (Vite) ----------------
# API URL (Leave blank to use Vite dev proxy in local development)
VITE_API_URL=http://localhost:5000

# Demo Mode: Set to 'true' to show "Demo accounts" box on Login page and "Reset demo data" in Settings
# Set to 'false' in production
VITE_DEMO_MODE=true
